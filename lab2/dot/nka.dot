digraph NFA {
    rankdir=LR;
    node [shape=circle];

    start [shape=point];
    start->q0;
    q7[shape=doublecircle];

    q0->q1[label="a"];
    q1->q2[label="a"];
    q2->q3[label="a"];
    q3->q0[label="ε"];
    q3->q4[label="a"];
    q4->q0[label="a"];

    q0->q5[label="ε"];
    q5->q7[label="b"];
    q5->q6[label="a"];
    q6->q7[label="a"];

    q7->q8[label="b"];
    q8->q7[label="b"];

    q7->q9[label="a"];
    q9->q10[label="a"];
    q10->q7[label="b"];
}
